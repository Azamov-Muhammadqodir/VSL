<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Visual Studio "Dark" environment palette -->
  <Color x:Key="SystemAccentColor">#007ACC</Color>
  <Color x:Key="SystemAccentColorDark1">#0E639C</Color>
  <Color x:Key="SystemAccentColorLight1">#1C97EA</Color>

  <SolidColorBrush x:Key="VsEnvironmentBrush" Color="#2D2D30" />
  <SolidColorBrush x:Key="VsToolWindowBrush" Color="#252526" />
  <SolidColorBrush x:Key="VsEditorBrush" Color="#1E1E1E" />
  <SolidColorBrush x:Key="VsBorderBrush" Color="#3F3F46" />
  <SolidColorBrush x:Key="VsMenuBrush" Color="#1B1B1C" />
  <SolidColorBrush x:Key="VsTextBrush" Color="#F1F1F1" />
  <SolidColorBrush x:Key="VsGrayTextBrush" Color="#999999" />
  <SolidColorBrush x:Key="VsAccentBrush" Color="#007ACC" />
  <SolidColorBrush x:Key="VsAccentHoverBrush" Color="#1C97EA" />
  <SolidColorBrush x:Key="VsTabInactiveBrush" Color="#3F3F46" />
  <SolidColorBrush x:Key="VsHoverBrush" Color="#3E3E40" />
  <SolidColorBrush x:Key="VsSelectionBrush" Color="#094771" />
  <SolidColorBrush x:Key="VsStatusReadyBrush" Color="#007ACC" />
  <SolidColorBrush x:Key="VsStatusBusyBrush" Color="#CA5100" />
  <SolidColorBrush x:Key="VsStatusEmptyBrush" Color="#68217A" />
  <SolidColorBrush x:Key="VsErrorBrush" Color="#F14C4C" />
  <SolidColorBrush x:Key="VsWarningBrush" Color="#CCA700" />
  <SolidColorBrush x:Key="VsInfoBrush" Color="#3794FF" />

  <!-- Debug toolbar glyphs (14x14) -->
  <StreamGeometry x:Key="IconStart">M3,1 L13,7 L3,13 Z</StreamGeometry>
  <StreamGeometry x:Key="IconStartNoDebug">M3,1 L13,7 L3,13 Z M4.6,3.8 L4.6,10.2 L10,7 Z</StreamGeometry>
  <StreamGeometry x:Key="IconStop">M2,2 L12,2 L12,12 L2,12 Z</StreamGeometry>
  <StreamGeometry x:Key="IconPause">M2,1 L5.5,1 L5.5,13 L2,13 Z M8.5,1 L12,1 L12,13 L8.5,13 Z</StreamGeometry>
  <StreamGeometry x:Key="IconRestart">M7,1.5 C3.4,1.5 1,4.2 1,7.5 C1,10.8 3.7,13.5 7,13.5 C10.3,13.5 13,10.8 13,7.5 L11,7.5 C11,9.7 9.2,11.5 7,11.5 C4.8,11.5 3,9.7 3,7.5 C3,5.3 4.8,3.5 7,3.5 L7,6 L10.5,2.5 L7,-1 Z</StreamGeometry>
  <StreamGeometry x:Key="IconStepInto">M6,0 L8,0 L8,5.5 L11,5.5 L7,9.5 L3,5.5 L6,5.5 Z M5.4,12 A1.6,1.6 0 1 0 8.6,12 A1.6,1.6 0 1 0 5.4,12 Z</StreamGeometry>
  <StreamGeometry x:Key="IconStepOut">M6,9.5 L8,9.5 L8,4.5 L11,4.5 L7,0.5 L3,4.5 L6,4.5 Z M5.4,12.4 A1.6,1.6 0 1 0 8.6,12.4 A1.6,1.6 0 1 0 5.4,12.4 Z</StreamGeometry>
  <StreamGeometry x:Key="IconStepOver">M1,9 C1,3 11,1.5 11.5,6 L13.5,6 L10.5,9.5 L7.5,6 L9.5,6 C9,3.5 3,4.5 3,9 Z M5.4,12 A1.6,1.6 0 1 0 8.6,12 A1.6,1.6 0 1 0 5.4,12 Z</StreamGeometry>

  <FontFamily x:Key="VsUiFont">Inter, Ubuntu, Noto Sans, sans-serif</FontFamily>
  <FontFamily x:Key="VsCodeFont">avares://VSL/Assets/Fonts#Cascadia Mono, DejaVu Sans Mono, Noto Sans Mono, monospace</FontFamily>

  <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
  <x:Double x:Key="TreeViewItemMinHeight">20</x:Double>
  <x:Double x:Key="ListBoxItemMinHeight">20</x:Double>

  <!-- Document well tab: blue when active, like VS -->
  <ControlTheme x:Key="VsDocumentTab" TargetType="TabItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#F1F1F1" />
    <Setter Property="Padding" Value="8,3,2,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,1,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_LayoutRoot" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="#1C97EA" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="#007ACC" />
    </Style>
  </ControlTheme>

  <!-- Tool window tab (Error List / Output) at the bottom of a tool window -->
  <ControlTheme x:Key="VsToolTab" TargetType="TabItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#D0D0D0" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_LayoutRoot" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="#55AAFF" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="#252526" />
      <Setter Property="Foreground" Value="#3399FF" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
