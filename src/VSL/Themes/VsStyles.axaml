<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource VsUiFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Menu">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Menu > MenuItem">
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Flat toolbar buttons -->
  <Style Selector="Button.tb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3E3E40" />
  </Style>
  <Style Selector="Button.tb:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.tb:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <!-- Icon-only toolbar button (VS: 22px high, icon centered, flat until hovered) -->
  <Style Selector="Button.tbi">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tbi:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3E3E40" />
  </Style>
  <Style Selector="Button.tbi:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#007ACC" />
  </Style>
  <Style Selector="Button.tbi:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.tb:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#007ACC" />
  </Style>

  <!-- Toolbar separator -->
  <Style Selector="Border.tbsep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="5,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="#4A4A4F" />
  </Style>

  <!-- Close / pin buttons inside document tabs -->
  <Style Selector="Button.tabbtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tabbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#52B0EF" />
  </Style>

  <!-- Dock guide zones -->
  <Style Selector="Border.dockzone">
    <Setter Property="Background" Value="#18007ACC" />
    <Setter Property="BorderBrush" Value="#007ACC" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Margin" Value="6" />
  </Style>
  <Style Selector="Border.dockzone > TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="#9CDCFE" />
    <Setter Property="Background" Value="#2D2D30" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Border.dockzone.hot">
    <Setter Property="Background" Value="#55007ACC" />
  </Style>

  <Style Selector="ToggleButton.tb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ToggleButton.tb:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3E3E40" />
    <Setter Property="BorderBrush" Value="#007ACC" />
  </Style>

  <Style Selector="ComboBox.tb">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="#333337" />
    <Setter Property="BorderBrush" Value="#434346" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Dense tree and lists, like VS tool windows -->
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ListBox.dense > ListBoxItem">
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="MinHeight" Value="20" />
  </Style>
  <!-- Git Changes rows: Undo / Stage buttons appear on hover or selection, as in VS. -->
  <Style Selector="ListBoxItem StackPanel.rowActions">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ListBoxItem:pointerover StackPanel.rowActions, ListBoxItem:selected StackPanel.rowActions">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ListBox.dense">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="TextBox.search">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="#333337" />
    <Setter Property="BorderBrush" Value="#434346" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="#2D2D30" />
  </Style>

  <Style Selector="TextBlock.toolTitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#D0D0D0" />
    <Setter Property="Margin" Value="8,4" />
  </Style>
</Styles>
