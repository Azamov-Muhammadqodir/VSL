<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VSL.ViewModels"
        xmlns:ws="using:VSL.Workspace"
        xmlns:v="using:VSL.Views"
        xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
        x:Class="VSL.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1600" Height="1000"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/vsl.png"
        Background="{StaticResource VsEnvironmentBrush}"
        Foreground="{StaticResource VsTextBrush}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+B" Command="{Binding BuildSolutionCommand}" />
    <KeyBinding Gesture="Ctrl+F5" Command="{Binding StartWithoutDebuggingCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding StartDebuggingCommand}" />
    <KeyBinding Gesture="Shift+F5" Command="{Binding StopCommand}" />
    <KeyBinding Gesture="Ctrl+F4" Command="{Binding CloseDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding OpenSolutionCommand}" />
    <KeyBinding Gesture="Ctrl+Pause" Command="{Binding CancelBuildCommand}" />
    <KeyBinding Gesture="F10" Command="{Binding StepOverCommand}" />
    <KeyBinding Gesture="F11" Command="{Binding StepIntoCommand}" />
    <KeyBinding Gesture="Shift+F11" Command="{Binding StepOutCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F5" Command="{Binding RestartCommand}" />
    <KeyBinding Gesture="Ctrl+Alt+Pause" Command="{Binding BreakAllCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <!-- ===== Menu ===== -->
    <Menu DockPanel.Dock="Top" Background="{StaticResource VsEnvironmentBrush}">
      <MenuItem Header="_File">
        <MenuItem Header="_Open Solution..." InputGesture="Ctrl+Shift+O" Command="{Binding OpenSolutionCommand}" />
        <MenuItem Name="RecentMenu" Header="Recent _Solutions" />
        <MenuItem Header="_Close Solution" Command="{Binding CloseSolutionCommand}" />
        <Separator />
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <MenuItem Header="Save A_ll" InputGesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}" />
        <MenuItem Header="Close _Document" InputGesture="Ctrl+F4" Command="{Binding CloseDocumentCommand}" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Click="OnUndo" />
        <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Click="OnRedo" />
        <Separator />
        <MenuItem Header="_Find..." InputGesture="Ctrl+F" Click="OnFind" />
        <MenuItem Header="Find in _Files..." InputGesture="Ctrl+Shift+F" Click="OnFindInFiles" />
        <Separator />
        <MenuItem Header="_Advanced">
          <!-- Avalonia's KeyGesture cannot express chords, so the chord is shown as text. -->
          <MenuItem Click="OnFormatDocument">
            <MenuItem.Header>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Format Document" />
                <TextBlock Grid.Column="1" Text="Ctrl+K, Ctrl+D" Margin="32,0,0,0" Foreground="{StaticResource VsGrayTextBrush}" />
              </Grid>
            </MenuItem.Header>
          </MenuItem>
        </MenuItem>
        <MenuItem Header="_Go To Definition" InputGesture="F12" Click="OnGoToDefinition" />
        <MenuItem Header="Go To _Implementation" InputGesture="Ctrl+F12" Click="OnGoToImplementation" />
        <MenuItem Header="Find All _References" InputGesture="Shift+F12" Click="OnFindReferences" />
        <MenuItem Header="Re_name..." InputGesture="F2" Click="OnRename" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Solution _Explorer" Click="OnShowSolutionExplorer" />
        <MenuItem Header="E_rror List" Click="OnShowErrorList" />
        <MenuItem Header="_Output" Click="OnShowOutput" />
        <Separator />
        <MenuItem Click="OnZoomIn">
          <MenuItem.Header>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Zoom In" />
              <TextBlock Grid.Column="1" Text="Ctrl+Shift+." Margin="32,0,0,0" Foreground="{StaticResource VsGrayTextBrush}" />
            </Grid>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="OnZoomOut">
          <MenuItem.Header>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Zoom Out" />
              <TextBlock Grid.Column="1" Text="Ctrl+Shift+," Margin="32,0,0,0" Foreground="{StaticResource VsGrayTextBrush}" />
            </Grid>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="OnZoomReset">
          <MenuItem.Header>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Reset Zoom" />
              <TextBlock Grid.Column="1" Text="Ctrl+0" Margin="32,0,0,0" Foreground="{StaticResource VsGrayTextBrush}" />
            </Grid>
          </MenuItem.Header>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Build">
        <MenuItem Header="_Build Solution" InputGesture="Ctrl+Shift+B" Command="{Binding BuildSolutionCommand}" />
        <MenuItem Header="_Rebuild Solution" Command="{Binding RebuildSolutionCommand}" />
        <MenuItem Header="_Clean Solution" Command="{Binding CleanSolutionCommand}" />
        <Separator />
        <MenuItem Header="Cance_l" InputGesture="Ctrl+Pause" Command="{Binding CancelBuildCommand}" />
      </MenuItem>
      <MenuItem Header="_Debug">
        <MenuItem Header="{Binding StartButtonText, StringFormat={}Start / {0}}" InputGesture="F5" Command="{Binding StartDebuggingCommand}" />
        <MenuItem Header="Start _Without Debugging" InputGesture="Ctrl+F5" Command="{Binding StartWithoutDebuggingCommand}" />
        <MenuItem Header="Stop _Debugging" InputGesture="Shift+F5" Command="{Binding StopCommand}" />
        <MenuItem Header="_Restart" InputGesture="Ctrl+Shift+F5" Command="{Binding RestartCommand}" />
        <MenuItem Header="Brea_k All" InputGesture="Ctrl+Alt+Pause" Command="{Binding BreakAllCommand}" />
        <Separator />
        <MenuItem Header="Step _Into" InputGesture="F11" Command="{Binding StepIntoCommand}" />
        <MenuItem Header="Step _Over" InputGesture="F10" Command="{Binding StepOverCommand}" />
        <MenuItem Header="Step Ou_t" InputGesture="Shift+F11" Command="{Binding StepOutCommand}" />
        <Separator />
        <MenuItem Header="Toggle _Breakpoint" InputGesture="F9" Click="OnToggleBreakpoint" />
        <MenuItem Header="Delete _All Breakpoints" Command="{Binding DeleteAllBreakpointsCommand}" />
        <Separator />
        <MenuItem Header="_Locals" Click="OnShowLocals" />
        <MenuItem Header="_Watch" Click="OnShowWatch" />
        <MenuItem Header="_Call Stack" Click="OnShowCallStack" />
      </MenuItem>
      <MenuItem Header="_Test">
        <MenuItem Command="{Binding RunAllTestsCommand}">
          <MenuItem.Header>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Run All Tests" />
              <TextBlock Grid.Column="1" Text="Ctrl+R, A" Margin="32,0,0,0" Foreground="{StaticResource VsGrayTextBrush}" />
            </Grid>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Command="{Binding RepeatLastTestRunCommand}">
          <MenuItem.Header>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Repeat Last Run" />
              <TextBlock Grid.Column="1" Text="Ctrl+R, L" Margin="32,0,0,0" Foreground="{StaticResource VsGrayTextBrush}" />
            </Grid>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Header="Run _Failed Tests" Command="{Binding RunFailedTestsCommand}" />
        <MenuItem Header="Re_fresh Tests" Command="{Binding RefreshTestsCommand}" />
        <MenuItem Header="_Cancel Test Run" Command="{Binding CancelTestRunCommand}" />
        <Separator />
        <MenuItem Click="OnShowTestExplorer">
          <MenuItem.Header>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Test Explorer" />
              <TextBlock Grid.Column="1" Text="Ctrl+E, T" Margin="32,0,0,0" Foreground="{StaticResource VsGrayTextBrush}" />
            </Grid>
          </MenuItem.Header>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Git" IsEnabled="{Binding HasGit}">
        <MenuItem Header="_Commit or Stash..." Command="{Binding ShowGitChangesCommand}" />
        <Separator />
        <MenuItem Header="_Fetch" Command="{Binding FetchCommand}" />
        <MenuItem Header="_Pull" Command="{Binding PullCommand}" />
        <MenuItem Header="P_ush" Command="{Binding PushCommand}" />
        <MenuItem Header="_Sync (Pull then Push)" Command="{Binding SyncCommand}" />
        <Separator />
        <MenuItem Header="_New Branch..." Command="{Binding NewBranchCommand}" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Restart Language Server" Command="{Binding RestartLanguageServerCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Keyboard Shortcuts" Click="OnShortcuts" />
        <MenuItem Header="_About VSL" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- ===== Standard toolbar ===== -->
    <Border DockPanel.Dock="Top" Background="{StaticResource VsEnvironmentBrush}" BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="0,0,0,1" Padding="4,2">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="tb" ToolTip.Tip="Open Solution (Ctrl+Shift+O)" Command="{Binding OpenSolutionCommand}">📂</Button>
        <Button Classes="tb" ToolTip.Tip="Save (Ctrl+S)" Command="{Binding SaveCommand}">💾</Button>
        <Button Classes="tb" ToolTip.Tip="Save All (Ctrl+Shift+S)" Command="{Binding SaveAllCommand}">⧉</Button>
        <Border Width="1" Background="{StaticResource VsBorderBrush}" Margin="4,2" />
        <Button Classes="tb" ToolTip.Tip="Undo (Ctrl+Z)" Click="OnUndo">↶</Button>
        <Button Classes="tb" ToolTip.Tip="Redo (Ctrl+Y)" Click="OnRedo">↷</Button>
        <Border Width="1" Background="{StaticResource VsBorderBrush}" Margin="4,2" />
        <ComboBox Classes="tb" Width="90" ItemsSource="{Binding Configurations}" SelectedItem="{Binding Configuration}" ToolTip.Tip="Solution Configurations" />
        <ComboBox Classes="tb" Width="160" ItemsSource="{Binding StartupProjects}" SelectedItem="{Binding StartupProject}" ToolTip.Tip="Startup Project" />
        <Button Classes="tb" Command="{Binding StartDebuggingCommand}" ToolTip.Tip="Start (F5)">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <PathIcon Data="{StaticResource IconStart}" Foreground="#89D185" Width="12" Height="12" />
            <TextBlock Text="{Binding StartButtonText}" />
          </StackPanel>
        </Button>
        <ComboBox Classes="tb" Width="22" ItemsSource="{Binding LaunchProfiles}" SelectedItem="{Binding LaunchProfile}" ToolTip.Tip="Launch Profile" />
        <Button Classes="tb" Command="{Binding StartWithoutDebuggingCommand}" ToolTip.Tip="Start Without Debugging (Ctrl+F5)">
          <PathIcon Data="{StaticResource IconStartNoDebug}" Foreground="#89D185" Width="12" Height="12" />
        </Button>
        <Button Classes="tb" Command="{Binding StopCommand}" ToolTip.Tip="Stop (Shift+F5)">
          <PathIcon Data="{StaticResource IconStop}" Foreground="#F48771" Width="11" Height="11" />
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsDebugging}">
          <Button Classes="tb" Command="{Binding BreakAllCommand}" ToolTip.Tip="Break All (Ctrl+Alt+Break)">
            <PathIcon Data="{StaticResource IconPause}" Foreground="#75BEFF" Width="11" Height="11" />
          </Button>
          <Button Classes="tb" Command="{Binding RestartCommand}" ToolTip.Tip="Restart (Ctrl+Shift+F5)">
            <PathIcon Data="{StaticResource IconRestart}" Foreground="#89D185" Width="12" Height="12" />
          </Button>
          <Border Width="1" Background="{StaticResource VsBorderBrush}" Margin="4,2" />
          <Button Classes="tb" Command="{Binding StepIntoCommand}" ToolTip.Tip="Step Into (F11)">
            <PathIcon Data="{StaticResource IconStepInto}" Foreground="#75BEFF" Width="12" Height="12" />
          </Button>
          <Button Classes="tb" Command="{Binding StepOverCommand}" ToolTip.Tip="Step Over (F10)">
            <PathIcon Data="{StaticResource IconStepOver}" Foreground="#75BEFF" Width="13" Height="12" />
          </Button>
          <Button Classes="tb" Command="{Binding StepOutCommand}" ToolTip.Tip="Step Out (Shift+F11)">
            <PathIcon Data="{StaticResource IconStepOut}" Foreground="#75BEFF" Width="12" Height="12" />
          </Button>
        </StackPanel>
        <Border Width="1" Background="{StaticResource VsBorderBrush}" Margin="4,2" />
        <Button Classes="tb" Command="{Binding BuildSolutionCommand}" ToolTip.Tip="Build Solution (Ctrl+Shift+B)">🔨 Build</Button>
      </StackPanel>
    </Border>

    <!-- ===== Status bar ===== -->
    <Border DockPanel.Dock="Bottom" Height="23" Background="{Binding Status, Converter={x:Static v:StatusBrushConverter.Instance}}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="8,0">
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="White" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding ServerStatus}" VerticalAlignment="Center" Foreground="White" Margin="0,0,24,0" />
        <TextBlock Grid.Column="2" Text="{Binding CaretText}" VerticalAlignment="Center" Foreground="White" MinWidth="120" Margin="0,0,16,0" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasGit}">
          <Button Classes="tb" Padding="6,0" MinHeight="20" Command="{Binding ShowGitChangesCommand}" ToolTip.Tip="Pending changes">
            <TextBlock Text="{Binding GitChangeCount, StringFormat=✎ {0}}" Foreground="White" />
          </Button>
          <Button Classes="tb" Padding="6,0" MinHeight="20" Click="OnBranchButtonClick" ToolTip.Tip="Branch">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding GitSyncText}" Foreground="White" />
              <TextBlock Text="{Binding GitBranch, StringFormat=⎇ {0}}" Foreground="White" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Main area: [documents / bottom tool windows] | Solution Explorer ===== -->
    <Grid Name="MainGrid" ColumnDefinitions="*,4,340">
      <Grid Name="LeftGrid" RowDefinitions="*,4,250">

        <!-- Document well -->
        <Panel Background="{StaticResource VsEnvironmentBrush}">
          <TabControl Name="DocumentTabs"
                      ItemsSource="{Binding Documents}"
                      SelectedItem="{Binding ActiveDocument}"
                      ItemContainerTheme="{StaticResource VsDocumentTab}"
                      Padding="0"
                      IsVisible="{Binding !!Documents.Count}">
            <TabControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DocumentViewModel">
                <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding FilePath}">
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                  <Button Classes="tb" Padding="3,0" MinHeight="16" FontSize="11"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseDocumentCommand}"
                          CommandParameter="{Binding}">✕</Button>
                </StackPanel>
              </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
              <DataTemplate x:DataType="vm:DocumentViewModel">
                <Border BorderBrush="#007ACC" BorderThickness="0,2,0,0">
                  <DockPanel>
                    <!-- VS's editor footer: zoom drop-down and the document health indicator -->
                    <Border DockPanel.Dock="Bottom" Background="#2D2D30" Height="20">
                      <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,0">
                        <Button Classes="tb" Padding="6,0" MinHeight="18" Click="OnZoomButtonClick"
                                ToolTip.Tip="Zoom (Ctrl+Wheel, Ctrl+Shift+. / Ctrl+Shift+, , Ctrl+0)">
                          <TextBlock Text="{Binding ZoomText, StringFormat={}{0} ▾}" FontSize="11" />
                        </Button>
                        <TextBlock Text="{Binding IssuesText}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource VsGrayTextBrush}" />
                      </StackPanel>
                    </Border>
                    <ContentControl Content="{Binding Host.Editor}" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </TabControl.ContentTemplate>
          </TabControl>

          <!-- Start window (no solution open) -->
          <StackPanel IsVisible="{Binding !HasSolution}" Margin="60,50" Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="VSL" FontSize="34" FontWeight="Light" />
            <TextBlock Text="Visual Studio for Linux" FontSize="16" Foreground="{StaticResource VsGrayTextBrush}" />
            <Button Command="{Binding OpenSolutionCommand}" Padding="16,10" Margin="0,16,0,0" Background="#333337">
              <StackPanel Spacing="2">
                <TextBlock Text="Open a project or solution" FontSize="14" />
                <TextBlock Text="Open a local .sln or .slnx file" Foreground="{StaticResource VsGrayTextBrush}" />
              </StackPanel>
            </Button>
            <TextBlock Text="Open recent" FontSize="14" Margin="0,16,0,0" />
            <ItemsControl ItemsSource="{Binding RecentSolutions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Button Classes="tb" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenRecentCommand}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="{Binding}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Panel>

        <GridSplitter Grid.Row="1" ResizeDirection="Rows" />

        <!-- Bottom tool windows -->
        <Border Grid.Row="2" Background="{StaticResource VsToolWindowBrush}" BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="1,1,1,0">
          <TabControl Name="BottomTabs" TabStripPlacement="Bottom" Padding="0"
                      SelectedIndex="{Binding BottomTabIndex}"
                      ItemContainerTheme="{StaticResource VsToolTab}">
            <!-- Error List -->
            <TabItem Header="Error List">
              <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource VsEnvironmentBrush}" Padding="4,2">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <ToggleButton Classes="tb" IsChecked="{Binding ShowErrors}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="⨂" Foreground="#F14C4C" />
                        <TextBlock Text="{Binding ErrorCount, StringFormat={}{0} Errors}" />
                      </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="tb" IsChecked="{Binding ShowWarnings}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="⚠" Foreground="#CCA700" />
                        <TextBlock Text="{Binding WarningCount, StringFormat={}{0} Warnings}" />
                      </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="tb" IsChecked="{Binding ShowMessages}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="ⓘ" Foreground="#3794FF" />
                        <TextBlock Text="{Binding MessageCount, StringFormat={}{0} Messages}" />
                      </StackPanel>
                    </ToggleButton>
                    <TextBlock Text="Build + IntelliSense" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource VsGrayTextBrush}" />
                  </StackPanel>
                </Border>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="28,90,*,130,200,60" Background="#2D2D30" Height="22">
                  <TextBlock Grid.Column="1" Text="Code" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" />
                  <TextBlock Grid.Column="2" Text="Description" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" />
                  <TextBlock Grid.Column="3" Text="Project" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" />
                  <TextBlock Grid.Column="4" Text="File" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" />
                  <TextBlock Grid.Column="5" Text="Line" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" />
                </Grid>
                <ListBox Name="ErrorListBox" Classes="dense" ItemsSource="{Binding Errors}" DoubleTapped="OnErrorDoubleTapped">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ErrorItem">
                      <Grid ColumnDefinitions="24,90,*,130,200,60" ToolTip.Tip="{Binding Description}">
                        <TextBlock Text="{Binding SeverityGlyph}" Foreground="{Binding SeverityColor, Converter={x:Static v:ColorStringConverter.Instance}}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Code}" Foreground="#3794FF" />
                        <TextBlock Grid.Column="2" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding Project}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{Binding File}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="5" Text="{Binding LineText}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>

            <!-- Output -->
            <TabItem Header="Output">
              <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource VsEnvironmentBrush}" Padding="4,2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Show output from:" VerticalAlignment="Center" />
                    <ComboBox Classes="tb" Width="200" ItemsSource="{Binding OutputChannels}" SelectedItem="{Binding SelectedOutput}" />
                    <Button Classes="tb" Click="OnClearOutput" ToolTip.Tip="Clear All">🧹</Button>
                  </StackPanel>
                </Border>
                <ae:TextEditor Name="OutputEditor"
                               Document="{Binding SelectedOutput.Document}"
                               IsReadOnly="True"
                               FontFamily="{StaticResource VsCodeFont}"
                               FontSize="12"
                               Background="#1E1E1E"
                               Foreground="#DCDCDC"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto" />
              </DockPanel>
            </TabItem>

            <!-- Find Symbol Results -->
            <TabItem Header="{Binding FindResultsTitle}">
              <ListBox Name="FindResultsBox" Classes="dense" ItemsSource="{Binding FindResults}" DoubleTapped="OnFindResultDoubleTapped">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FindResultItem">
                    <TextBlock Text="{Binding Display}" FontFamily="{StaticResource VsCodeFont}" ToolTip.Tip="{Binding FilePath}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>

            <!-- Locals -->
            <TabItem Header="Locals">
              <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="260,*,220" Background="#2D2D30" Height="22">
                  <TextBlock Text="Name" Margin="24,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" />
                  <TextBlock Grid.Column="1" Text="Value" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" />
                  <TextBlock Grid.Column="2" Text="Type" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" />
                </Grid>
                <TreeView Name="LocalsTree" ItemsSource="{Binding Locals}" Background="Transparent">
                  <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:VariableNode">
                      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                  </TreeView.Styles>
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:VariableNode" ItemsSource="{Binding Children}">
                      <Grid ColumnDefinitions="236,*,220" Height="20">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#9CDCFE" TextTrimming="CharacterEllipsis" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" FontFamily="{StaticResource VsCodeFont}" />
                        <TextBlock Grid.Column="2" Text="{Binding Type}" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </DockPanel>
            </TabItem>

            <!-- Watch -->
            <TabItem Header="Watch 1">
              <DockPanel>
                <TextBox Name="WatchInput" DockPanel.Dock="Top" Classes="search" Margin="4"
                         PlaceholderText="Add item to watch (Enter)" KeyDown="OnWatchInputKeyDown" />
                <Grid DockPanel.Dock="Top" ColumnDefinitions="260,*,220,28" Background="#2D2D30" Height="22">
                  <TextBlock Text="Name" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" />
                  <TextBlock Grid.Column="1" Text="Value" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" />
                  <TextBlock Grid.Column="2" Text="Type" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" />
                </Grid>
                <ListBox Classes="dense" ItemsSource="{Binding Watches}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:WatchItem">
                      <Grid ColumnDefinitions="256,*,220,28">
                        <TextBlock Text="{Binding Expression}" Foreground="#9CDCFE" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" FontFamily="{StaticResource VsCodeFont}" />
                        <TextBlock Grid.Column="2" Text="{Binding Type}" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="3" Classes="tb" Padding="3,0" MinHeight="16" ToolTip.Tip="Delete Watch"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveWatchCommand}"
                                CommandParameter="{Binding}">✕</Button>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>

            <!-- Call Stack -->
            <TabItem Header="Call Stack">
              <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="24,*,200" Background="#2D2D30" Height="22">
                  <TextBlock Grid.Column="1" Text="Name" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" />
                  <TextBlock Grid.Column="2" Text="Location" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" />
                </Grid>
                <ListBox Classes="dense" ItemsSource="{Binding CallStack}" SelectedItem="{Binding SelectedFrame}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:StackFrameItem">
                      <Grid ColumnDefinitions="24,*,200">
                        <TextBlock Text="➜" Foreground="#FFE400" IsVisible="{Binding HasSource}" />
                        <TextBlock Grid.Column="1" Text="{Binding Display}" FontFamily="{StaticResource VsCodeFont}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Location}" Foreground="{StaticResource VsGrayTextBrush}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>
          </TabControl>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <!-- Solution Explorer -->
      <Border Grid.Column="2" Background="{StaticResource VsToolWindowBrush}" BorderBrush="{StaticResource VsBorderBrush}" BorderThickness="1,0,0,0">
        <TabControl Name="RightTabs" TabStripPlacement="Bottom" Padding="0"
                    SelectedIndex="{Binding RightTabIndex}"
                    ItemContainerTheme="{StaticResource VsToolTab}">
          <TabItem Header="Solution Explorer">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="{StaticResource VsEnvironmentBrush}">
                <TextBlock Classes="toolTitle" Text="Solution Explorer" />
              </Border>
              <Border DockPanel.Dock="Top" Padding="4,2" Background="{StaticResource VsToolWindowBrush}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Classes="tb" Click="OnSyncWithActiveDocument" ToolTip.Tip="Sync with Active Document">⇄</Button>
                  <Button Classes="tb" Command="{Binding CollapseAllCommand}" ToolTip.Tip="Collapse All">⊟</Button>
                  <Button Classes="tb" Command="{Binding RefreshExplorerCommand}" ToolTip.Tip="Refresh">⟳</Button>
                </StackPanel>
              </Border>
              <TextBox Name="ExplorerSearch" DockPanel.Dock="Top" Classes="search" Margin="4,0,4,4"
                       PlaceholderText="Search Solution Explorer (Ctrl+;)" TextChanged="OnExplorerSearchChanged" />
              <Panel>
                <TreeView Name="ExplorerTree" ItemsSource="{Binding ExplorerRoots}" DoubleTapped="OnExplorerDoubleTapped"
                          KeyDown="OnExplorerKeyDown" Background="Transparent">
                  <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="ws:ExplorerNode">
                      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                  </TreeView.Styles>
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="ws:ExplorerNode" ItemsSource="{Binding Children}">
                      <StackPanel Orientation="Horizontal" Spacing="6" Height="20">
                        <ContentControl Content="{Binding IconKey, Converter={x:Static v:IconConverter.Instance}}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Detail}" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" />
                        <TextBlock Text="{Binding GitBadge}" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{Binding GitBadgeColor, Converter={x:Static v:ColorStringConverter.Instance}}" />
                      </StackPanel>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
                <ListBox Name="ExplorerSearchResults" Classes="dense" IsVisible="False" DoubleTapped="OnSearchResultDoubleTapped">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="ws:ExplorerNode">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <ContentControl Content="{Binding IconKey, Converter={x:Static v:IconConverter.Instance}}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Detail}" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Panel>
            </DockPanel>
          </TabItem>
          <!-- Test Explorer -->
          <TabItem Header="Test Explorer">
            <Grid RowDefinitions="Auto,Auto,Auto,*,4,170">
              <Border Background="{StaticResource VsEnvironmentBrush}">
                <TextBlock Classes="toolTitle" Text="Test Explorer" />
              </Border>
              <Border Grid.Row="1" Padding="4,2">
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="tb" Command="{Binding RunAllTestsCommand}" ToolTip.Tip="Run All Tests (Ctrl+R, A)">
                    <PathIcon Data="{StaticResource IconRunAll}" Foreground="#89D185" Width="13" Height="12" />
                  </Button>
                  <Button Classes="tb" Command="{Binding RunSelectedTestsCommand}" ToolTip.Tip="Run">
                    <PathIcon Data="{StaticResource IconStart}" Foreground="#89D185" Width="12" Height="12" />
                  </Button>
                  <Button Classes="tb" Command="{Binding RunFailedTestsCommand}" ToolTip.Tip="Run Failed Tests">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <PathIcon Data="{StaticResource IconStart}" Foreground="#89D185" Width="10" Height="10" />
                      <PathIcon Data="{Binding Source={x:Static vm:TestStateIcons.Failed}, Converter={x:Static v:TestStateIconConverter.Instance}}" Foreground="#F14C4C" Width="9" Height="9" />
                    </StackPanel>
                  </Button>
                  <Button Classes="tb" Command="{Binding RepeatLastTestRunCommand}" ToolTip.Tip="Repeat Last Run (Ctrl+R, L)">
                    <PathIcon Data="{StaticResource IconRestart}" Foreground="#89D185" Width="12" Height="12" />
                  </Button>
                  <Button Classes="tb" Command="{Binding CancelTestRunCommand}" ToolTip.Tip="Cancel">
                    <PathIcon Data="{StaticResource IconStop}" Foreground="#F48771" Width="10" Height="10" />
                  </Button>
                  <Button Classes="tb" Command="{Binding RefreshTestsCommand}" ToolTip.Tip="Build and discover tests">⟳</Button>
                  <Border Width="1" Background="{StaticResource VsBorderBrush}" Margin="4,2" />
                  <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0" VerticalAlignment="Center" ToolTip.Tip="Passed">
                    <PathIcon Data="{Binding Source={x:Static vm:TestStateIcons.Passed}, Converter={x:Static v:TestStateIconConverter.Instance}}" Foreground="#89D185" Width="12" Height="12" />
                    <TextBlock Text="{Binding PassedCount}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0" VerticalAlignment="Center" ToolTip.Tip="Failed">
                    <PathIcon Data="{Binding Source={x:Static vm:TestStateIcons.Failed}, Converter={x:Static v:TestStateIconConverter.Instance}}" Foreground="#F14C4C" Width="12" Height="12" />
                    <TextBlock Text="{Binding FailedCount}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0" VerticalAlignment="Center" ToolTip.Tip="Skipped">
                    <PathIcon Data="{Binding Source={x:Static vm:TestStateIcons.Skipped}, Converter={x:Static v:TestStateIconConverter.Instance}}" Foreground="#CCA700" Width="12" Height="12" />
                    <TextBlock Text="{Binding SkippedCount}" />
                  </StackPanel>
                </WrapPanel>
              </Border>
              <TextBlock Grid.Row="2" Text="{Binding TestSummary}" Margin="8,2" TextWrapping="Wrap" Foreground="{StaticResource VsGrayTextBrush}" />
              <TreeView Grid.Row="3" Name="TestTree" ItemsSource="{Binding TestRoots}" SelectedItem="{Binding SelectedTest}"
                        DoubleTapped="OnTestDoubleTapped" Background="Transparent">
                <TreeView.Styles>
                  <Style Selector="TreeViewItem" x:DataType="vm:TestNode">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                  <TreeDataTemplate x:DataType="vm:TestNode" ItemsSource="{Binding Children}">
                    <Grid ColumnDefinitions="Auto,*,Auto" Height="20">
                      <PathIcon Data="{Binding State, Converter={x:Static v:TestStateIconConverter.Instance}}"
                                Foreground="{Binding StateColor, Converter={x:Static v:ColorStringConverter.Instance}}"
                                Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding DurationText}" Margin="12,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource VsGrayTextBrush}" />
                    </Grid>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
              <GridSplitter Grid.Row="4" ResizeDirection="Rows" />
              <ScrollViewer Grid.Row="5" Padding="8,4">
                <StackPanel Spacing="4" DataContext="{Binding SelectedTest}" x:DataType="vm:TestNode">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Location}" Foreground="{StaticResource VsGrayTextBrush}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{Binding State, Converter={x:Static v:TestStateIconConverter.Instance}}"
                              Foreground="{Binding StateColor, Converter={x:Static v:ColorStringConverter.Instance}}" Width="12" Height="12" />
                    <TextBlock Text="{Binding State}" />
                    <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource VsGrayTextBrush}" />
                  </StackPanel>
                  <SelectableTextBlock Text="{Binding ErrorMessage}" Foreground="#F14C4C" TextWrapping="Wrap" FontFamily="{StaticResource VsCodeFont}" />
                  <SelectableTextBlock Text="{Binding StackTrace}" TextWrapping="Wrap" FontFamily="{StaticResource VsCodeFont}" FontSize="11" />
                  <SelectableTextBlock Text="{Binding Output}" TextWrapping="Wrap" FontFamily="{StaticResource VsCodeFont}" FontSize="11" Foreground="{StaticResource VsGrayTextBrush}" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </TabItem>

          <!-- Git Changes -->
          <TabItem Header="Git Changes">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="{StaticResource VsEnvironmentBrush}">
                <TextBlock Classes="toolTitle" Text="Git Changes" />
              </Border>
              <StackPanel DockPanel.Dock="Top" Margin="8,6" Spacing="6" IsVisible="{Binding HasGit}">
                <Grid ColumnDefinitions="*,Auto">
                  <Button Classes="tb" Click="OnBranchButtonClick" HorizontalAlignment="Left" ToolTip.Tip="Switch or create a branch">
                    <TextBlock Text="{Binding GitBranch, StringFormat=⎇ {0} ▾}" FontWeight="SemiBold" />
                  </Button>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <Button Classes="tb" Command="{Binding FetchCommand}" ToolTip.Tip="Fetch">⟳</Button>
                    <Button Classes="tb" Command="{Binding PullCommand}" ToolTip.Tip="Pull">↓</Button>
                    <Button Classes="tb" Command="{Binding PushCommand}" ToolTip.Tip="Push">↑</Button>
                    <Button Classes="tb" Command="{Binding SyncCommand}" ToolTip.Tip="Sync (Pull then Push)">⇅</Button>
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding GitSyncText, StringFormat=Outgoing / incoming: {0}}" Foreground="{StaticResource VsGrayTextBrush}" IsVisible="{Binding !!GitSyncText.Length}" />
                <TextBox Text="{Binding CommitMessage}" PlaceholderText="Enter a message &lt;Required&gt;" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="60" MaxHeight="140" Background="#333337" BorderBrush="#434346" />
                <Button Command="{Binding CommitCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#0E639C" Foreground="White">
                  <TextBlock Text="{Binding CommitButtonText}" />
                </Button>
              </StackPanel>
              <TextBlock DockPanel.Dock="Top" Margin="8" TextWrapping="Wrap" Foreground="{StaticResource VsGrayTextBrush}"
                         IsVisible="{Binding !HasGit}" Text="The open solution is not in a Git repository." />
              <ScrollViewer IsVisible="{Binding HasGit}">
                <StackPanel Margin="4,0" Spacing="2">
                  <Grid ColumnDefinitions="*,Auto" Margin="4,4,4,0">
                    <TextBlock Text="{Binding StagedChanges.Count, StringFormat=Staged Changes ({0})}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="tb" Command="{Binding UnstageAllCommand}" ToolTip.Tip="Unstage All">−</Button>
                  </Grid>
                  <ListBox Classes="dense" ItemsSource="{Binding StagedChanges}" DoubleTapped="OnGitItemDoubleTapped">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:GitFileItem">
                        <Grid ColumnDefinitions="18,Auto,*,Auto" ToolTip.Tip="{Binding Change.RelativePath}">
                          <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" Foreground="{Binding LetterColor, Converter={x:Static v:ColorStringConverter.Instance}}" />
                          <TextBlock Grid.Column="1" Text="{Binding FileName}" />
                          <TextBlock Grid.Column="2" Text="{Binding Folder}" Margin="8,0,0,0" Foreground="{StaticResource VsGrayTextBrush}" TextTrimming="CharacterEllipsis" />
                          <Button Grid.Column="3" Classes="tb" Padding="4,0" MinHeight="16" ToolTip.Tip="Unstage"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).UnstageCommand}" CommandParameter="{Binding}">−</Button>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Grid ColumnDefinitions="*,Auto" Margin="4,8,4,0">
                    <TextBlock Text="{Binding UnstagedChanges.Count, StringFormat=Changes ({0})}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="tb" Command="{Binding StageAllCommand}" ToolTip.Tip="Stage All">+</Button>
                  </Grid>
                  <ListBox Classes="dense" ItemsSource="{Binding UnstagedChanges}" DoubleTapped="OnGitItemDoubleTapped">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:GitFileItem">
                        <Grid ColumnDefinitions="18,Auto,*,Auto,Auto" ToolTip.Tip="{Binding Change.RelativePath}">
                          <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" Foreground="{Binding LetterColor, Converter={x:Static v:ColorStringConverter.Instance}}" />
                          <TextBlock Grid.Column="1" Text="{Binding FileName}" />
                          <TextBlock Grid.Column="2" Text="{Binding Folder}" Margin="8,0,0,0" Foreground="{StaticResource VsGrayTextBrush}" TextTrimming="CharacterEllipsis" />
                          <Button Grid.Column="3" Classes="tb" Padding="4,0" MinHeight="16" ToolTip.Tip="Undo Changes"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DiscardCommand}" CommandParameter="{Binding}">↶</Button>
                          <Button Grid.Column="4" Classes="tb" Padding="4,0" MinHeight="16" ToolTip.Tip="Stage"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).StageCommand}" CommandParameter="{Binding}">+</Button>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </DockPanel>
</Window>
